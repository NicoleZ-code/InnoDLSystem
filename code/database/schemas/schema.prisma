generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model MeasurementPoint {
  id String @id
  assetId String @map("asset_id")
  name String
  unit String
  quality String @default("simulated")
  metric String @default("voltage")
  enabled Boolean @default(true)
  @@map("measurement_points")
}
model AlarmRule {
  id String @id
  pointId String @map("point_id")
  name String
  operator String @default("gt")
  threshold Float
  severity String @default("attention")
  enabled Boolean @default(true)
  @@map("alarm_rules")
}
