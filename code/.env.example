API_HOST=127.0.0.1
API_PORT=8787
DATABASE_URL=postgresql://YOUR_LOCAL_USER@localhost:5432/innodl_system
SIMULATION_INTERVAL_MS=1000
LOG_LEVEL=info
# 可选本地 Redis；Compose 会自动配置 Redis 及 MinIO。
# REDIS_URL=redis://:YOUR_PASSWORD@127.0.0.1:6379
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=innodl
# MINIO_SECRET_KEY=YOUR_PASSWORD
MINIO_BUCKET=innodl-models
COOKIE_SECURE=false
VITE_DATA_MODE=server
# pnpm setup 自动生成以下凭据，不要在生产环境使用示例密码。
POSTGRES_USER=innodl
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=innodl
MINIO_ROOT_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
