{
  "name": "innodl-system",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/setup-hooks.mjs",
    "mock": "pnpm --filter @innodl/mock-telemetry dev",
    "test:e2e": "playwright test",
    "dev:web": "pnpm --filter @innodl/twin-screen dev",
    "dev:api": "pnpm --filter @innodl/api-server dev",
    "start": "pnpm --filter @innodl/api-server start",
    "dev:admin": "pnpm --filter @innodl/admin-web dev",
    "setup": "node infra/scripts/setup-env.mjs",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up --build -d",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "db:generate": "pnpm --filter @innodl/api-server db:generate",
    "seed:demo": "node --env-file-if-exists=.env database/seed/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@prisma/client": "6.19.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "tsup": "^8.5.0",
    "turbo": "^2.5.8",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "@zip.js/zip.js": "2.7.70",
      "@cesium/widgets": "13.0.0",
      "@cesium/engine": "19.0.0",
      "fastify": "5.11.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "type": "module"
}
