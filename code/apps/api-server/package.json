{
  "name": "@innodl/api-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "prisma generate --schema ../../database/schemas/schema.prisma"
  },
  "dependencies": {
