    "zod": "^4.1.0",
    "dotenv": "^17.2.3",
    "ws": "^8.18.3",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pg": "^8.16.3",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "6.19.0",
    "redis": "^5.9.0",
    "minio": "^8.0.6",
    "@innodl/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
